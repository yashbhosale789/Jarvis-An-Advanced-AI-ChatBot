-- Enable the vector extension if not already enabled
CREATE EXTENSION IF NOT EXISTS vector;

-- Create or recreate marvel_characters_phase_three with proper structure
DROP TABLE IF EXISTS marvel_characters_phase_three;
CREATE TABLE marvel_characters_phase_three (
    character_id INTEGER PRIMARY KEY,
    character_name VARCHAR,
    real_name VARCHAR,
    actor VARCHAR,
    debut_movie VARCHAR,
    debut_year INTEGER,
    team_affiliation VARCHAR,
    status VARCHAR,
    powers VARCHAR,
    embedding VECTOR(1536)
);

-- Copy data from the original table (removing duplicates)
INSERT INTO marvel_characters_phase_three (
    character_id, character_name, real_name, actor, debut_movie, 
    debut_year, team_affiliation, status, powers
)
SELECT DISTINCT ON (character_id) 
    character_id, character_name, real_name, actor, debut_movie, 
    debut_year, team_affiliation, status, powers
FROM marvel_characters;

-- Create or recreate marvel_characters_phase_three_csv
DROP TABLE IF EXISTS marvel_characters_phase_three_csv;
CREATE TABLE marvel_characters_phase_three_csv (
    file_name VARCHAR PRIMARY KEY,
    content TEXT,
    embedding VECTOR(1536)
);

-- Create or recreate marvel_characters_phase_three_pdf
DROP TABLE IF EXISTS marvel_characters_phase_three_pdf;
CREATE TABLE marvel_characters_phase_three_pdf (
    file_name VARCHAR PRIMARY KEY,
    content TEXT,
    embedding VECTOR(1536)
);

-- Create history table
CREATE TABLE IF NOT EXISTS marvel_characters_phase_three_history (
    id SERIAL PRIMARY KEY,
    role VARCHAR(50) NOT NULL,
    content TEXT NOT NULL,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

